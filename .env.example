# Secret used to sign session cookies. CHANGE THIS in production!
SECRET_KEY=please-change-this-to-a-long-random-string

# Async SQLite database URL
DATABASE_URL=sqlite+aiosqlite:///./data/osint_hub.db

# Where generated PDF reports are stored
REPORTS_DIR=./data/reports

# Per-engine timeouts (seconds)
SHERLOCK_TIMEOUT=180
MAIGRET_TIMEOUT=240

# Per-site request timeout passed to the engines (seconds)
SITE_TIMEOUT=15

# Session lifetime (seconds). Default: 7 days
SESSION_MAX_AGE=604800

LOG_LEVEL=INFO
